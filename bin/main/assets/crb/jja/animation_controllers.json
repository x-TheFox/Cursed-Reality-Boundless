 "controller.animation.beru.movement": {
  "initial_state": "static",
  "states": {
   "move": {
    "animations": [
     "move"
    ],
    "blend_transition": 0.1,
    "transitions": [
     {
      "static": "query.ground_speed < 0.1 && query.property('property:awaken') == 0"
