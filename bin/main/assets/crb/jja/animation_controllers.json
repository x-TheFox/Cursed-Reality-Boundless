      "sprint": "query.ground_speed>0.1&&query.has_target"
     }
    ]
   }
  }
 },
 "controller.animation.soulking_idle": {
  "initial_state": "idle",
  "states": {
   "idle": {
    "animations": [
     "soulking_idle"
    ],
    "blend_transition": 0.0,
    "transitions": [
     {
      "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting"
     },
     {
      "sprint": "query.is_on_ground && q.is_sprinting"
     },
     {
      "jump": "query.is_jumping && !query.is_in_water"
     }
    ]
   },
   "jump": {
    "animations": [
     "soulking_jump"
    ],
    "blend_transition": 0.1,
    "transitions": [
     {
      "idle": "query.is_on_ground && !query.is_moving"
     },
     {
      "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting"
     },
     {
      "sprint": "query.is_on_ground && q.is_sprinting"
     }
    ]
   },
   "sprint": {
    "animations": [
     "soulking_sprint"
    ],
    "blend_transition": 0.0,
    "transitions": [
     {
      "walk": "query.is_moving && query.is_on_ground && !q.is_sprinting"
     },
     {
      "idle": "query.is_on_ground && !query.is_moving"
     },
     {
      "jump": "query.is_jumping && !query.is_in_water"
     }
    ]
   },
   "walk": {
    "animations": [
     "soulking_walk"
    ],
    "blend_transition": 0.2,
    "transitions": [
     {
      "idle": "query.is_on_ground && !query.is_moving"
     },
     {
      "sprint": "query.is_on_ground && q.is_sprinting"
     },
     {
      "jump": "query.is_jumping && !query.is_in_water"
     }
    ]
   }
  }
