 "controller.animation.divinedog.attack": {
  "states": {
   "attack1": {
    "animations": [
     "attack1"
    ],
    "blend_transition": 0.2,
    "transitions": [
     {
      "default": "query.all_animations_finished"
     }
    ]
   },
   "attack2": {
    "animations": [
     "attack2"
    ],
    "blend_transition": 0.2,
    "transitions": [
     {
      "default": "query.all_animations_finished"
     }
    ]
   },
   "default": {
    "blend_transition": 0.2,
    "transitions": [
     {
      "attack1": "query.is_delayed_attacking && variable.random == 0"
     },
     {
      "attack2": "query.is_delayed_attacking && variable.random == 1"
     }
    ]
   }
  }
 },
 "controller.animation.divinedog.move": {
  "states": {
   "default": {
    "animations": [
     {
      "move": "variable.move_speed"
     }
    ],
    "variables": {
     "move_speed": {
      "input": "query.modified_move_speed",
      "remap_curve": {
       "0.0": 0.0,
       "0.25": 1.0
      }
     }
    }
   }
  }
