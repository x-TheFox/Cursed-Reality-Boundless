     }
    ]
   },
   "sprint": {
    "animations": [
     "sprint"
    ],
    "blend_transition": 0.1,
    "transitions": [
     {
      "static": "query.ground_speed < 0.1 && query.property('property:awaken') == 0"
     },
     {
      "move": "query.ground_speed > 0.1 && !query.has_target && query.property('property:awaken') == 0"
     }
    ]
   },
   "static": {
    "animations": [
     "static"
    ],
    "blend_transition": 0.1,
    "transitions": [
     {
      "move": "query.ground_speed > 0.1 && !query.has_target && query.property('property:awaken') == 0"
     },
     {
      "sprint": "query.ground_speed > 0.1 && query.has_target && query.property('property:awaken') == 0"
     }
    ]
   }
  }
 },
 "controller.animation.beru_awaken.movement": {
  "initial_state": "static_awaken",
